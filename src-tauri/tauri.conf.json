{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "radboard",
  "version": "0.7.0",
  "identifier": "org.mikolajczyk.radboard",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "radboard",
        "width": 1024,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Kanban board for Radicle",
    "longDescription": "Desktop Kanban board for Radicle repositories. Manage issues, patches, worktrees, notifications, and files across multiple repos.",
    "category": "DeveloperTool",
    "homepage": "https://radboard.mikolajczyk.org",
    "publisher": "Mikołaj Mikołajczyk",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
